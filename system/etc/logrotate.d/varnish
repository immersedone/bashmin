/var/log/varnish/varnishncsa.log {
  daily
  rotate 30
  dateext
  dateformat -%Y-%m-%d
  missingok
  compress
  delaycompress
  missingok
  postrotate
    if [ -d /run/systemd/system ]; then
       systemctl -q is-active varnishncsa.service || exit 0
    fi
    /usr/sbin/invoke-rc.d varnishncsa reload > /dev/null
  endscript
}
