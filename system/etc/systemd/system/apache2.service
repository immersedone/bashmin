##########################################################
#
#   File: /etc/systemd/system/apache2.service
#   Author: Truc Minh Phan <immersedone>
#   Last Modified: Truc Minh Phan (21/01/2020)
#   Description:
#
#   This is the base service file that handles
#   execution tasks such as reload/restart/start/stop
#   for the 'apache2' service. Has been modified
#   to allow for auto-healing; meaning will
#   automatically restart upon any interrupts to
#   the service. 
#
#   ######################################################
#
#   Notes: Taken from standard configuration from 
#   multi-user.target.wants/ folder.
#
#
##

[Unit]
Description=The Apache HTTP Server
After=network.target remote-fs.target nss-lookup.target
StartLimitInterval=20
StartLimitBurst=5

[Service]
Type=forking
Environment=APACHE_STARTED_BY_SYSTEMD=true
ExecStart=/usr/sbin/apachectl start
ExecStop=/bin/bash /usr/share/scripts/notify-service-crash apache2 ; /usr/sbin/apachectl stop
ExecReload=/usr/sbin/apachectl graceful
PrivateTmp=true
Restart=always
RestartSec=3s

[Install]
WantedBy=multi-user.target