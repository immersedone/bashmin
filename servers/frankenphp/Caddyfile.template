#
# File: Caddyfile.template
# Description: Main Caddyfile template for FrankenPHP server
# 

# Global options
{
	frankenphp
	order php_server before file_server
	order php before file_server
}

# Import all virtual hosts
import vhosts/*

# Default catch-all for development
# FrankenPHP uses port range 8100-8199, localhost only
127.0.0.1:8100 {
	root * /var/www/html
	php_server
}

# IPv6 localhost support (if enabled)
[::1]:8100 {
	root * /var/www/html
	php_server
}
